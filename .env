# Database & App Secrets
MYSQL_HOST=localhost
MYSQL_USER=root
MYSQL_PASSWORD=061502kp
MYSQL_DB=tailored_travel
SECRET_KEY=your-secret-key

# CORS
CORS_ORIGINS=http://localhost:5173

#Data
DATA_CSV=./ai_model/data/Scaled_Merged_Travel_Dataset_augmented.csv
MODEL_DIR=./ai_model/outputs/models
HYBRID_MODEL_FILE=hybrid_travel_recommender_model.keras
SCALER_FILE=scaler.joblib
ENCODER_FILE=encoder.joblib
CF_FILE=cf_model.joblib
CB_FILE=cb_recommender.joblib
CLUSTER_FILE=clusters.joblib

# ML artifact directory (overrides default if you like)
# By default we point to ai_model/outputs/models
# If you ever move your models elsewhere, set MODEL_DIR here:
# MODEL_DIR=C:/path/to/your/models
MODEL_DIR=

# Currency settings
USER_CURRENCY=USD
DEST_CURRENCY=EUR

# Skyscanner API (leave blank to disable flight pricing)
SKY_API_KEY=
SKY_ORIGIN=NYCA-sky
SKY_COUNTRY=US
SKY_CURRENCY=USD
SKY_LOCALE=en-US

# Booking.com API (stubbed by default)
BOOKING_API_KEY=
BOOKING_AFFILIATE_ID=
BOOKER_COUNTRY=us

# Server port
PORT=5000
